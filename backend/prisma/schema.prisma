// Prisma schema for Geprek-Supply Smart Routing.
// Default provider is SQLite so the project runs with zero external services.
// For production, switch `provider` to "mysql" / "postgresql" and point
// DATABASE_URL at your instance - the models below are portable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A serviced area (e.g. Priok, Sawangan, Tangsel) with a store center used as
/// the origin for every smart-radius calculation.
model Region {
  id        Int        @id @default(autoincrement())
  key       String     @unique // url-safe slug: "priok"
  name      String // display name: "Priok"
  centerLat Float
  centerLng Float
  suppliers Supplier[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

/// A supplier/market offering a raw material at a given price and location.
model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  material  String
  unit      String   @default("kg") // selling unit / weight, e.g. "kg", "tabung 3 kg", "liter"
  lat       Float
  lng       Float
  price     Int // price per unit in IDR (integer, no decimals)
  icon      String // Font Awesome class fragment, e.g. "fa-drumstick-bite"
  rating    Float? // supplier rating 0-5 (optional; example data until real ratings provided)
  openHour  Int      @default(7) // opening hour (0-23)
  closeHour Int      @default(20) // closing hour (0-23)
  inStock   Boolean  @default(true)
  region    Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  regionId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([regionId])
}

/// A shop owner who registered their store as a supplier (self-service).
/// shopName & email are unique so a single record is found directly (no duplicates).
model Merchant {
  id        Int      @id @default(autoincrement())
  ownerName String
  shopName  String   @unique
  email     String   @unique
  password  String // bcrypt hash
  kecamatan String
  kota      String?
  kabupaten String?
  kodePos   String?
  phone     String?
  landmark  String? // "patokan" / nearest landmark
  lat          Float? // geocoded from the address (for placing products on the map)
  lng          Float?
  resetToken   String? // sha256 of the password-reset token
  resetExpires DateTime?
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// A product a registered merchant sells (managed from their own dashboard).
model Product {
  id         Int      @id @default(autoincrement())
  name       String
  price      Int      @default(0) // price per unit in IDR
  unit       String   @default("pcs")
  stock      Int      @default(0) // quantity on hand
  inStock    Boolean  @default(true)
  imageUrl   String? // uploaded product photo (data URL for the localhost prototype)
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  merchantId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([merchantId])
}
