# Backend environment template — copy to `backend/.env`
#   cp backend/.env.example backend/.env

# Server
NODE_ENV=development
PORT=4000

# Database — SQLite by default (zero external dependencies).
# Swap to a MySQL/Postgres URL in production and update prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# CORS allow-list (comma-separated origins permitted to call the API)
CORS_ORIGINS=http://localhost:5173

# Admin gate - email(s) allowed to mutate stock via the dashboard.
# Add more admins by separating with commas, e.g.
#   ADMIN_EMAIL=admin@example.com,teman@example.com
ADMIN_EMAIL=admin@example.com

# Optional — TomTom Routing API key for REAL-TIME, traffic-aware ETA.
# Free key (no credit card): https://developer.tomtom.com → My Apps → Add new key.
# Leave empty to use OSRM (road distance, no live traffic).
TOMTOM_API_KEY=
