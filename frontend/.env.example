# Frontend environment template — copy to `frontend/.env`
#   cp frontend/.env.example frontend/.env

# Base URL of the REST API. In dev you can leave this as the relative "/api"
# (Vite proxies it to the backend) or point it at the full origin.
VITE_API_URL=/api

# Admin email(s) allowed into the dashboard login (comma-separated).
# MUST match the backend's ADMIN_EMAIL. Defaults to damtafaiz@gmail.com if unset.
#   VITE_ADMIN_EMAIL=damtafaiz@gmail.com,teman@gmail.com
VITE_ADMIN_EMAIL=damtafaiz@gmail.com
