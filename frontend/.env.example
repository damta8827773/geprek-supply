# Frontend environment template - copy to `frontend/.env`
#   cp frontend/.env.example frontend/.env

# Base URL of the REST API. In dev you can leave this as the relative "/api"
# (Vite proxies it to the backend) or point it at the full origin.
VITE_API_URL=/api

# Admin email(s) allowed into the dashboard login (comma-separated).
# MUST match the backend's ADMIN_EMAIL. Defaults to admin@example.com if unset.
#   VITE_ADMIN_EMAIL=admin@example.com,teman@example.com
VITE_ADMIN_EMAIL=admin@example.com

# WhatsApp support/report number (format 62xxxx, no + or leading 0).
# Leave empty here; put the real number only in the gitignored frontend/.env.
VITE_WA_REPORT=
